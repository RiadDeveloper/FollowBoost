# FollowBoost — root .gitignore
# Secrets and signing material — NEVER commit these.
.keystore-password.txt
app/android/app/keystore.jks
app/android/key.properties
**/*.jks
**/*.keystore
**/key.properties

# Backend database + secrets — real user data.
backend/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Internal build log (contains machine paths) — not for publication.
BUILD_LOG.md

# Scratch / test artifacts from local builds.
TlsTest.java
TlsTest.class
media-generation-*
prewarm.log

# Flutter / Dart
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
app/android/.gradle/
app/android/local.properties
**/Flutter/ephemeral/
.idea/
*.iml
*.ipr
*.iws
*.class
*.log
*.pyc
*.swp

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
